--========================
-- LEFT TAB MENU
--========================
local left = Instance.new("Frame")
left.Size = UDim2.new(0,120,1,0)
left.BackgroundColor3 = Color3.fromRGB(25,25,35)
left.Parent = main

local function tab(name, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,0,0,40)
	b.Position = UDim2.new(0,0,0,y)
	b.Text = name
	b.TextScaled = true
	b.BackgroundColor3 = Color3.fromRGB(40,40,60)
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = left
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
	return b
end

local potTab = tab("Potions", 10)
local setTab = tab("Settings", 60)

--========================
-- RIGHT CONTENT
--========================
local right = Instance.new("Frame")
right.Size = UDim2.new(1,-120,1,0)
right.Position = UDim2.new(0,120,0,0)
right.BackgroundTransparency = 1
right.Parent = main

-- PAGES
local potPage = Instance.new("Frame", right)
potPage.Size = UDim2.new(1,0,1,0)
potPage.BackgroundTransparency = 1

local setPage = Instance.new("Frame", right)
setPage.Size = potPage.Size
setPage.BackgroundTransparency = 1
setPage.Visible = false

--========================
-- POTION LIST
--========================
local potions = {
	"Healing Potion",
	"Mana Potion",
	"Speed Potion",
	"Strength Potion"
}

local y = 10

for _,v in ipairs(potions) do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-20,0,35)
	b.Position = UDim2.new(0,10,0,y)
	b.Text = v
	b.BackgroundColor3 = Color3.fromRGB(45,45,70)
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = potPage
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
	y += 40
end

--========================
-- SETTINGS TOGGLES
--========================
local function toggle(text, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.9,0,0,40)
	b.Position = UDim2.new(0.05,0,0,y)
	b.Text = text
	b.BackgroundColor3 = Color3.fromRGB(70,30,30)
	b.TextScaled = true
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = setPage
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
	return b
end

local brew = toggle("AUTO BREW: OFF", 10)
local block = toggle("BLOCK DAMAGE: OFF", 60)

--========================
-- TAB SWITCH
--========================
potTab.MouseButton1Click:Connect(function()
	potPage.Visible = true
	setPage.Visible = false
end)

setTab.MouseButton1Click:Connect(function()
	potPage.Visible = false
	setPage.Visible = true
end)

--========================
-- OPEN / CLOSE
--========================
open.MouseButton1Click:Connect(function()
	main.Visible = not main.Visible
end)
