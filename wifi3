local blockBtn = Instance.new("TextButton")
blockBtn.Size = UDim2.new(0.9,0,0,45)
blockBtn.Position = UDim2.new(0.05,0,0,120)
blockBtn.BackgroundColor3 = Color3.fromRGB(170,50,50)
blockBtn.Text = "BLOCK DAMAGE: OFF"
blockBtn.TextScaled = true
blockBtn.Parent = frame

Instance.new("UICorner", blockBtn).CornerRadius = UDim.new(0,10)

blockBtn.MouseButton1Click:Connect(function()
	blockDamage = not blockDamage
	blockBtn.Text = blockDamage and "BLOCK DAMAGE: ON" or "BLOCK DAMAGE: OFF"
end)

--========================
-- CLOSE / OPEN
--========================
openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

--========================
-- DRAG FRAME
--========================
local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

