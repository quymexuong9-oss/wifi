end)

combatTab.MouseButton1Click:Connect(function()
	currentTab = "Combat"
	loadList()
end)

--========================
-- SEARCH FILTER
--========================
search:GetPropertyChangedSignal("Text"):Connect(function()
	local txt = string.lower(search.Text)

	for _,b in ipairs(scroll:GetChildren()) do
		if b:IsA("TextButton") then
			if string.find(string.lower(b.Text), txt) then
				b.Visible = true
			else
				b.Visible = false
			end
		end
	end
end)
