local potions = {
	{Name="Healing Potion", Type="Healing", Recipe="Red Flower x1\nHerb x2\nWater x1"},
	{Name="Mega Healing Potion", Type="Healing", Recipe="Red Flower x3\nHoly Herb x2\nPure Water x1"},

	{Name="Mana Potion", Type="Magic", Recipe="Blue Crystal x2\nMana Leaf x1"},
	{Name="Arcane Potion", Type="Magic", Recipe="Magic Core x1\nBlue Crystal x5"},

	{Name="Speed Potion", Type="Combat", Recipe="Wind Grass x2\nFeather x1"},
	{Name="Ultra Speed Potion", Type="Combat", Recipe="Lightning Feather x2\nWind Essence x3"},

	{Name="Strength Potion", Type="Combat", Recipe="Bear Fang x3\nPower Stone x1"},
	{Name="Titan Potion", Type="Combat", Recipe="Titan Core x1\nBear Fang x6"},
}

local currentTab = "Healing"
local buttons = {}

--========================
-- CREATE LIST
--========================
local function loadList()
	scroll:ClearAllChildren()
	layout.Parent = scroll
	buttons = {}

	for _,p in ipairs(potions) do
		if p.Type == currentTab then

			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1,-10,0,35)
			b.BackgroundColor3 = Color3.fromRGB(45,45,70)
			b.TextColor3 = Color3.new(1,1,1)
			b.Text = p.Name
			b.Parent = scroll

			Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)

			b.MouseButton1Click:Connect(function()
				display.Text = p.Recipe
			end)

			table.insert(buttons, b)
		end
	end
end

loadList()

--========================
-- TAB SWITCH
--========================
healTab.MouseButton1Click:Connect(function()
	currentTab = "Healing"
	loadList()
end)

magicTab.MouseButton1Click:Connect(function()
