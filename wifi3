local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "WizardAlchemyFixed"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

--========================
-- OPEN BUTTON
--========================
local openBtn = Instance.new("TextButton")
openBtn.Size = UDim2.new(0,50,0,50)
openBtn.Position = UDim2.new(0,10,0.7,0)
openBtn.Text = "🧪"
openBtn.BackgroundColor3 = Color3.fromRGB(130,0,255)
openBtn.TextScaled = true
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1,0)

--========================
-- MAIN FRAME
--========================
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0,280,0,320)
frame.Position = UDim2.new(0,70,0.25,0)
frame.BackgroundColor3 = Color3.fromRGB(20,20,30)
frame.Visible = false
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0,10)

-- TITLE
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,35)
title.Text = "Wizard Alchemy"
title.BackgroundColor3 = Color3.fromRGB(120,0,255)
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true
title.Parent = frame

--========================
-- DATA
--========================
local potions = {
	"Healing Potion",
	"Mana Potion",
	"Speed Potion",
	"Strength Potion",
	"Fire Potion",
	"Ice Potion",
}

local selectedPotion = nil
local autoBrew = false
local blockDamage = false

--========================
-- LIST AREA (FIXED)
--========================
local list = Instance.new("Frame")
list.Size = UDim2.new(1,0,1,-120)
list.Position = UDim2.new(0,0,0,40)
list.BackgroundTransparency = 1
list.Parent = frame

local y = 0

for _,p in ipairs(potions) do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.9,0,0,30)
	b.Position = UDim2.new(0.05,0,0,y)
	b.Text = p
	b.BackgroundColor3 = Color3.fromRGB(45,45,70)
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = list
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)

	b.MouseButton1Click:Connect(function()
		selectedPotion = p
		title.Text = "Selected: "..p
	end)

	y += 32
end

--========================
-- TOGGLES
--========================
local brewBtn = Instance.new("TextButton")
brewBtn.Size = UDim2.new(0.9,0,0,35)
brewBtn.Position = UDim2.new(0.05,0,1,-70)
brewBtn.Text = "AUTO BREW: OFF"
brewBtn.BackgroundColor3 = Color3.fromRGB(0,170,100)
brewBtn.TextScaled = true
brewBtn.Parent = frame
Instance.new("UICorner", brewBtn).CornerRadius = UDim.new(0,6)

brewBtn.MouseButton1Click:Connect(function()
	autoBrew = not autoBrew
	brewBtn.Text = autoBrew and "AUTO BREW: ON" or "AUTO BREW: OFF"
end)

local blockBtn = Instance.new("TextButton")
blockBtn.Size = UDim2.new(0.9,0,0,35)
blockBtn.Position = UDim2.new(0.05,0,1,-35)
blockBtn.Text = "BLOCK DAMAGE: OFF"
blockBtn.BackgroundColor3 = Color3.fromRGB(170,50,50)
blockBtn.TextScaled = true
blockBtn.Parent = frame
Instance.new("UICorner", blockBtn).CornerRadius = UDim.new(0,6)

blockBtn.MouseButton1Click:Connect(function()
	blockDamage = not blockDamage
	blockBtn.Text = blockDamage and "BLOCK DAMAGE: ON" or "BLOCK DAMAGE: OFF"
end)

--========================
-- OPEN/CLOSE
--========================
openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

print("Wizard Alchemy GUI Loaded")
