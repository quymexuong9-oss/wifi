--========================
-- STATE
--========================
local autoBrew = false
local blockDamage = false

--========================
-- BUTTON CREATOR
--========================
local function createButton(txt, y, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.9,0,0,40)
	b.Position = UDim2.new(0.05,0,0,y)
	b.BackgroundColor3 = color
	b.Text = txt
	b.TextScaled = true
	b.Font = Enum.Font.GothamBold
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = frame

	Instance.new("UICorner", b).CornerRadius = UDim.new(0,10)
	return b
end

--========================
-- BUTTONS
--========================
local brewBtn = createButton("AUTO BREW: OFF", 50, Color3.fromRGB(0,170,100))
local blockBtn = createButton("BLOCK DAMAGE: OFF", 100, Color3.fromRGB(170,50,50))

brewBtn.MouseButton1Click:Connect(function()
	autoBrew = not autoBrew
	brewBtn.Text = autoBrew and "AUTO BREW: ON" or "AUTO BREW: OFF"
end)

blockBtn.MouseButton1Click:Connect(function()
	blockDamage = not blockDamage
	blockBtn.Text = blockDamage and "BLOCK DAMAGE: ON" or "BLOCK DAMAGE: OFF"
end)

--========================
-- TOGGLE GUI BUTTON
--========================
openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

--========================
-- DRAG
--========================
local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
