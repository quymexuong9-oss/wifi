brewBtn.TextScaled = true
brewBtn.Parent = frame

Instance.new("UICorner", brewBtn).CornerRadius = UDim.new(0,10)

brewBtn.MouseButton1Click:Connect(function()
	autoBrew = not autoBrew
	brewBtn.Text = autoBrew and "AUTO BREW: ON" or "AUTO BREW: OFF"
