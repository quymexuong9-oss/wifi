--========================
-- STATES
--========================
local autoBrew = false
local blockDamage = false
local selectedPotion = ""

--========================
-- LIST
--========================
local potions = {
	"Healing Potion",
	"Mana Potion",
	"Speed Potion",
	"Strength Potion"
}

local y = 45

for _,v in ipairs(potions) do

	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.9,0,0,35)
	b.Position = UDim2.new(0.05,0,0,y)
	b.BackgroundColor3 = Color3.fromRGB(45,45,65)
	b.Text = v
	b.TextScaled = true
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = frame

	Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

	b.MouseButton1Click:Connect(function()
		selectedPotion = v

		for _,x in ipairs(frame:GetChildren()) do
			if x:IsA("TextButton") then
				x.BackgroundColor3 = Color3.fromRGB(45,45,65)
			end
		end

		b.BackgroundColor3 = Color3.fromRGB(120,0,255)
	end)

	y = y + 38
end

