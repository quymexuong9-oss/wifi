-- Wizard Alchemy Premium GUI - Clean Version
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local gui = Instance.new("ScreenGui")
gui.Name = "WizardAlchemy"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 340, 0, 480)
frame.Position = UDim2.new(0.5, -170, 0.5, -240)
frame.BackgroundColor3 = Color3.fromRGB(22, 22, 35)
frame.BorderSizePixel = 0
frame.Visible = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 55)
title.BackgroundColor3 = Color3.fromRGB(90, 0, 200)
title.Text = "WIZARD ALCHEMY"
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -38, 0, 12)
closeBtn.BackgroundTransparency = 1
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.new(1,1,1)
closeBtn.TextScaled = true
closeBtn.Parent = frame

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 60, 0, 60)
toggleBtn.Position = UDim2.new(0, 20, 0, 20)
toggleBtn.BackgroundColor3 = Color3.fromRGB(90, 0, 200)
toggleBtn.Text = "🧪"
toggleBtn.TextScaled = true
toggleBtn.Parent = gui

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1,0)
toggleCorner.Parent = toggleBtn

-- Potion Data
local potionData = {
    ["Healing Potion"] = "1x Red Flower\n2x Healing Herb\n1x Pure Water",
    ["Mana Potion"] = "2x Blue Crystal\n1x Mana Leaf\n1x Magic Essence",
    ["Strength Potion"] = "3x Bear Fang\n1x Power Stone\n2x Red Mushroom",
    ["Speed Potion"] = "2x Wind Grass\n1x Swift Feather\n1x Lightning Bug",
    ["Fire Arrow Potion"] = "2x Fire Crystal\n1x Flame Flower\n1x Dragon Scale",
    ["Ice Spike Potion"] = "2x Ice Shard\n1x Frost Leaf\n1x Frozen Heart",
    ["Dragon Breath Potion"] = "1x Dragon Scale\n2x Fire Essence\n1x Ancient Bone",
}

local selectedPotion = ""
local brewing = false
local blocking = false

-- Buttons
local brewBtn = Instance.new("TextButton")
brewBtn.Size = UDim2.new(0.9,0,0,50)
brewBtn.Position = UDim2.new(0.05,0,0,100)
brewBtn.Text = "AUTO BREW: OFF"
brewBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
brewBtn.TextColor3 = Color3.new(1,1,1)
brewBtn.TextScaled = true
brewBtn.Parent = frame

local blockBtn = Instance.new("TextButton")
blockBtn.Size = UDim2.new(0.9,0,0,50)
blockBtn.Position = UDim2.new(0.05,0,0,160)
blockBtn.Text = "AUTO BLOCK: OFF"
blockBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
blockBtn.TextColor3 = Color3.new(1,1,1)
blockBtn.TextScaled = true
blockBtn.Parent = frame

-- Toggle & Close
toggleBtn.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
end)

closeBtn.MouseButton1Click:Connect(function()
    frame.Visible = false
end)

brewBtn.MouseButton1Click:Connect(function()
    brewing = not brewing
    brewBtn.Text = "AUTO BREW: " .. (brewing and "ON ✅" or "OFF")
end)

blockBtn.MouseButton1Click:Connect(function()
    blocking = not blocking
    blockBtn.Text = "AUTO BLOCK: " .. (blocking and "ON ✅" or "OFF")
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = LocalPlayer.Character.HumanoidRootPart
    local hum = LocalPlayer.Character:FindFirstChild("Humanoid")

    if blocking and hum then
        hum.Health = hum.MaxHealth
    end

    if brewing and selectedPotion \~= "" then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name:lower():find("cauldron") or obj.Name:lower():find("alchemy") then
                if (obj.Position - root.Position).Magnitude < 25 then
                    root.CFrame = obj.CFrame * CFrame.new(0, 5, 6)
                    pcall(function()
                        game:GetService("ReplicatedStorage"):FindFirstChild("BrewPotion", true):FireServer(selectedPotion, 1)
                    end)
                    wait(2)
                    break
                end
            end
        end
    end
end)

print("✅ Wizard Alchemy Premium GUI Loaded!")
